# .env.example  --  copy this file to .env.local and fill in YOUR values.
#
#   PUBLIC  = safe to ship inside the app that runs in a visitor’s browser.
#             Anyone can read it. It is only safe because your database
#             rules (Row Level Security) decide what it may see.
#   SECRET  = never in the browser, never in git, never pasted into chat.
#             It lives only in server functions and your host’s secret store.
#
# Use DIFFERENT values for staging and production. See docs/environments.md.
# Never put a real value in this file. It is committed to git.

# Which copy of the app this is: local, staging or production.
APP_ENV=local

# ---------- PUBLIC ----------
# Your Supabase project address (public).
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The Supabase "anon" / publishable key (public -- ONLY safe when RLS is on).
PUBLIC_SUPABASE_ANON_KEY=replace-with-your-publishable-key
# Your payment provider publishable key (public).
PUBLIC_PAYMENTS_PUBLISHABLE_KEY=replace-with-your-publishable-key
# Your monitoring / error-reporting DSN (public).
PUBLIC_MONITORING_DSN=replace-with-your-dsn

# ---------- SECRET ----------
# Supabase service-role key: bypasses ALL database rules. Server only.
SUPABASE_SERVICE_ROLE_KEY=replace-me-server-only
# Payment provider secret key. Server only.
PAYMENTS_SECRET_KEY=replace-me-server-only
# Used to prove a webhook really came from your payment provider. Server only.
PAYMENTS_WEBHOOK_SIGNING_SECRET=replace-me-server-only
# Email-sending service key. Server only.
EMAIL_API_KEY=replace-me-server-only
# Any AI model API key. Server only -- and it costs money if it leaks.
AI_API_KEY=replace-me-server-only
