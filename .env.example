# .env.example  --  the names this app reads, with empty values.
#
# Copy it to web/.env.local and fill in YOUR staging values. Never put a real
# value in this file: it is committed to git.
#
#   PUBLIC  = safe to ship inside the app that runs in a visitor's browser.
#             Anyone can read it. It is only safe because your database
#             rules (Row Level Security) decide what it may see.
#   SECRET  = never in the browser, never in git, never pasted into chat.
#             It lives only in server functions and your host's secret store.
#
# In Next.js, only names beginning NEXT_PUBLIC_ reach the browser. A secret
# must never be given that prefix.
#
# Use DIFFERENT values for staging and production. See docs/environments.md,
# which lists what each copy needs and who holds it.
#
# This file is also read by hosts on import -- Vercel pre-fills environment
# variables from it -- so it lists only what the app really uses today. A name
# added here in advance becomes a slot in a dashboard waiting to be filled.

# ---------- PUBLIC ----------

# The staging project's address, e.g. https://<project-ref>.supabase.co
# Local and Preview use staging. Production gets the production project.
NEXT_PUBLIC_SUPABASE_URL=

# The Supabase publishable key, e.g. sb_publishable_...
# Public ONLY because row-level security decides what it may reach.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------- NEITHER PUBLIC NOR SECRET ----------

# This site's own address, e.g. http://localhost:3000 for local work.
#
# OPTIONAL. Used for one thing: the link in a password-reset email, which is
# built as <SITE_URL>/auth/reset. Leave it empty and the app sends no redirect
# address at all, so Supabase uses the project's own Site URL setting instead --
# which is why nothing breaks when it is unset.
#
# No NEXT_PUBLIC_ prefix on purpose: it is not needed in the browser, and a name
# without the prefix is never put into the browser bundle. Whichever address is
# used must also be on that Supabase project's Redirect URLs allow-list.
# See docs/environments.md -> "SITE_URL, and why it is optional".
SITE_URL=

# ---------- SECRET ----------

# None. The app has no server-side secret today: it talks to Supabase with the
# publishable key and lets the database rules decide. Nothing secret belongs in
# Vercel in this design -- see docs/environments.md. When the first one arrives
# (a service-role key for a server function, or an email-sending key), add the
# name here, leave the value empty, and put the real value only in the host's
# secret store.
