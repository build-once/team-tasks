{
  "name": "build-once",
  "version": "0.1.0",
  "private": true,
  "description": "A free starter kit that adds safety nets to projects built with AI coding assistants.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "guard:test": "node .claude/guard/selftest.mjs",
    "guard:check": "node .claude/guard/check.mjs",
    "skills:lint": "node scripts/lint-skills.mjs",
    "launch:check": "node scripts/launch-check.mjs",
    "vet": "node scripts/vet-tool.mjs",
    "handoff": "node scripts/handoff.mjs",
    "workflows:check": "node scripts/check-workflows.mjs --selftest && node scripts/check-workflows.mjs",
    "vet:test": "node scripts/vet-tool.mjs --selftest",
    "handoff:test": "node scripts/handoff.mjs --selftest",
    "drift:test": "node scripts/drift-check.mjs --selftest",
    "ai-team:test": "node addons/ai-team/files/.github/ai-team/selftest.mjs && node scripts/check-workflows.mjs addons/ai-team/files",
    "test": "npm run guard:test && npm run skills:lint && node scripts/launch-check.mjs --selftest && npm run workflows:check && npm run vet:test && npm run handoff:test && npm run drift:test && npm run ai-team:test"
  }
}
