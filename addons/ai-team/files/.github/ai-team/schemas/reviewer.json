{
  "type": "object",
  "additionalProperties": false,
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "file", "line", "severity", "problem"],
        "properties": {
          "rule": { "type": "string", "maxLength": 10 },
          "file": { "type": "string", "maxLength": 200 },
          "line": { "type": "integer", "minimum": 1 },
          "severity": { "type": "string", "enum": ["info", "warning", "problem"] },
          "problem": { "type": "string", "maxLength": 600 }
        }
      }
    }
  }
}
