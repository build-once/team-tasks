{
  "mcpServers": {
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "-e",
        "GITHUB_READ_ONLY",
        "-e",
        "GITHUB_LOCKDOWN_MODE",
        "-e",
        "GITHUB_TOOLSETS",
        "ghcr.io/github/github-mcp-server:v1.12.2"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_MCP_READONLY_TOKEN}",
        "GITHUB_READ_ONLY": "1",
        "GITHUB_LOCKDOWN_MODE": "1",
        "GITHUB_TOOLSETS": "repos,issues,pull_requests"
      }
    }
  }
}
